# Copie para .env.local (desenvolvimento, ignorado pelo Git) OU configure as mesmas
# variáveis na Vercel (Settings > Environment Variables) para produção.
# Valores privados nunca vão em NEXT_PUBLIC_*. Sem nada preenchido, o app usa dados de exemplo.

# PostgreSQL (opcional até existir o primeiro schema). Build e testes não precisam dele.
DATABASE_URL=
# Conexão direta opcional, para provedores que exigem isso em migrations.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info

# Instagram Graph API (business_discovery). Permissões do token:
#   instagram_business_basic, pages_show_list, business_management
# Em produção use um token long-lived ou um System User (não expira); tokens curtos expiram em ~1h.
INSTAGRAM_ACCESS_TOKEN=
# ID numérico da sua conta comercial do Instagram (a conta que consulta outros perfis).
INSTAGRAM_BUSINESS_ID=
# Concorrentes acompanhados no Market Radar (separados por vírgula, "@perfil" aceito, até 10).
# Precisam ser contas comerciais/criador públicas. Vazio = Market Radar com dados de exemplo.
INSTAGRAM_COMPETITORS=

# Segredo da coleta diária (/api/cron/snapshot). Gere uma string aleatória de 16+ caracteres.
# A Vercel envia este valor ao chamar o cron definido em vercel.json.
CRON_SECRET=

# Perfil padrão analisado (conta comercial/criador pública). Pode ser trocado via ?target= na URL.
INSTAGRAM_TARGET_USERNAME=biodev

# Verificação de domínio do app Meta (opcional): código da meta tag
# "facebook-domain-verification" (business.facebook.com/settings/domains). Vazio = sem tag.
META_VERIFICATION_CODE=

# Login com Google (Better Auth). Crie o cliente OAuth no Google Cloud (passo a passo em docs/onboarding.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Segredo que assina as sessões: 32+ caracteres aleatórios (ex.: `npx @better-auth/cli secret`).
BETTER_AUTH_SECRET=
# Endereço público do site. Em desenvolvimento: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# E-mails do Google com acesso ao painel de admin, separados por vírgula. Nunca escreva no código.
ADMIN_EMAILS=
# WhatsApp do suporte mostrado aos clientes (DDD + número; com ou sem 55, qualquer formatação).
SUPPORT_WHATSAPP=
